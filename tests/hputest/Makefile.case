ifndef AM_HOME
$(error AM_HOME must point to this Nexus-AM checkout)
endif
ifndef CASE_SOURCE
$(error CASE_SOURCE must name one HPU testcase source)
endif
ifndef CASE_ID
$(error CASE_ID must name one HPU testcase)
endif
ifndef HPU_DST_DIR
$(error HPU_DST_DIR must name the testcase object directory)
endif

TEST_ROOT := $(CURDIR)
INLINE_ASM_ROOT ?= $(TEST_ROOT)/third_party/inline-asm
HPU_GENERATED_ROOT ?= $(TEST_ROOT)/build/generated
HPU_DUMP_RESULTS ?= 0
HPU_LOG_LEVEL ?= 1
HPU_APPLICATION_TIMEOUT_CYCLES ?= 25000000
HPU_PERF_WARMUP_ROUNDS ?= 1
HPU_PERF_MEASURE_ROUNDS ?= 3
ifeq ($(filter $(HPU_LOG_LEVEL),0 1 2),)
$(error HPU_LOG_LEVEL must be 0, 1, or 2)
endif
ifneq ($(HPU_DUMP_RESULTS),0)
ifneq ($(HPU_DUMP_RESULTS),1)
$(error HPU_DUMP_RESULTS must be 0 or 1)
endif
endif
ifeq ($(HPU_DUMP_RESULTS),1)
ifneq ($(HPU_LOG_LEVEL),2)
$(error HPU_DUMP_RESULTS=1 requires HPU_LOG_LEVEL=2)
endif
endif
INLINE_ASM_MM_ROOT := $(HPU_GENERATED_ROOT)/inline-asm/mm
# .incbin 只从本次已校验的交付目录取数据，不读取 submodule 遗留输出。
ASFLAGS += -Wa,-I$(INLINE_ASM_MM_ROOT)/test_data/hardware
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/instruction-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/transform-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/bconv-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/keyswitch-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/auto-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/hadd-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/hmul-data
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/rotate-data
INLINE_ASM_DELIVERY_HEADER := \
  $(HPU_GENERATED_ROOT)/include/hpu/inline_asm_mm_delivery.h

ifeq ($(wildcard $(INLINE_ASM_DELIVERY_HEADER)),)
$(error missing generated inline-asm delivery; run 'make prepare-inline-asm-mm')
endif

NAME := $(CASE_ID)
SRCS := $(CASE_SOURCE)
ifneq ($(findstring /src/00_bringup/,$(CASE_SOURCE)),)
ifneq ($(findstring /001_hpu_smoke/,$(CASE_SOURCE)),)
SRCS += $(TEST_ROOT)/src/common/hpu_rns_fixture.S
endif
ifneq ($(filter %/00_04_psync_irq.c %/00_05_dload_irq.c \
                %/00_07_loopback_irq.c \
                %/00_08_compute_irq.c,$(CASE_SOURCE)),)
SRCS += $(TEST_ROOT)/src/common/hpu_irq.c
endif
ifneq ($(filter %/001_hpu_smoke/00_08_compute_irq.c \
                %/001_hpu_smoke/00_09_compute_mmio.c,$(CASE_SOURCE)),)
ifeq ($(wildcard $(INLINE_ASM_MM_ROOT)/mm.c),)
$(error missing complete producer MM program; run 'make prepare-inline-asm-mm')
endif
SRCS += $(TEST_ROOT)/src/common/hpu_mm_fixture.S
SRCS += $(INLINE_ASM_MM_ROOT)/mm.c
INC_DIR += $(INLINE_ASM_MM_ROOT)
endif
else
# Migrated IT cases keep scenario steps in their own readable main.c and share
# the small, single-purpose adapters under runtime/.  Runtime files never live
# below src/, so build.sh cannot mistake one for an executable testcase.
HPU_IT_RUNTIME_SRCS := $(filter-out $(TEST_ROOT)/runtime/it_log_silent.c,$(sort $(wildcard $(TEST_ROOT)/runtime/*.c)))
ifeq ($(strip $(HPU_IT_RUNTIME_SRCS)),)
$(error missing migrated HPU IT runtime sources under $(TEST_ROOT)/runtime)
endif
SRCS += $(HPU_IT_RUNTIME_SRCS)
# Most migrated finite cases consume the producer's two 4096-coefficient RNS
# inputs. Application-package cases own complete images and must not link that
# unrelated fixture.
APPLICATION_STEM := $(shell awk -F '\t' '$$1 == "$(CASE_ID)" {print $$2}' $(TEST_ROOT)/scheme-cases.tsv)
APPLICATION_DELIVERY := application-data
LARGE_STEM := $(shell awk -F '\t' '$$1 == "$(CASE_ID)" {print $$2}' $(TEST_ROOT)/large-cases.tsv)
ifneq ($(strip $(LARGE_STEM)),)
APPLICATION_STEM := $(LARGE_STEM)
APPLICATION_DELIVERY := large-data
endif
PERF_STEM := $(shell awk -F '\t' '$$1 == "$(CASE_ID)" {print $$3}' $(TEST_ROOT)/perf-cases.tsv)
ifneq ($(strip $(PERF_STEM)),)
APPLICATION_STEM := $(PERF_STEM)
APPLICATION_DELIVERY := $(shell awk -F '\t' '$$1 == "$(CASE_ID)" {print $$4}' $(TEST_ROOT)/perf-cases.tsv)
PERF_MEMORY_BASE := $(shell awk -F '\t' '$$1 == "$(CASE_ID)" {print $$9}' $(TEST_ROOT)/perf-cases.tsv)
ifeq ($(strip $(PERF_MEMORY_BASE)),)
$(error missing memory contract for performance case $(CASE_ID))
endif
CFLAGS += -DHPU_CASE_MEM_BASE=$(PERF_MEMORY_BASE)ULL
ifeq ($(HPU_LOG_LEVEL),2)
$(error performance endpoints exclude UART; use HPU_LOG_LEVEL=0 or 1)
endif
endif
ifneq ($(filter 03_%_n65536 04_%_n65536 05_%_n65536,$(CASE_ID)),)
CFLAGS += -DHPU_CASE_MEM_BASE=0x90000000ULL
endif
ifeq ($(strip $(APPLICATION_STEM)),)
SRCS += $(TEST_ROOT)/src/common/hpu_rns_fixture.S
endif
ifneq ($(filter %/02_18_watchdog_compute_before_dload.c %/02_19_watchdog_pmodld_before_dload.c,$(CASE_SOURCE)),)
# 缺依赖负向用例的后排DLOAD指向producer真模表，不合成或读取未初始化数据。
SRCS += $(TEST_ROOT)/src/common/hpu_mm_fixture.S
endif
ifneq ($(filter %/03_05_pntt.c %/03_06_pintt.c,$(CASE_SOURCE)),)
SRCS += $(TEST_ROOT)/src/common/it_stage_twiddle.S
endif
ifneq ($(filter %/03_08_psync.c %/03_17_psync_n65536.c,$(CASE_SOURCE)),)
SRCS += $(TEST_ROOT)/src/common/hpu_irq.c
endif
ifneq ($(filter %/04_02_ntt_n4096.c %/04_03_intt_n4096.c \
                %/07_01_ntt_n4096.c %/07_02_intt_n4096.c,$(CASE_SOURCE)),)
SRCS += $(TEST_ROOT)/src/common/it_transform.c
SRCS += $(TEST_ROOT)/src/common/it_transform_fixture.S
INC_DIR += $(HPU_GENERATED_ROOT)/transform-data
endif
ifneq ($(filter %/04_02_ntt_n4096.c %/07_01_ntt_n4096.c,$(CASE_SOURCE)),)
SRCS += $(HPU_GENERATED_ROOT)/transform-data/ntt/ntt.c
endif
ifneq ($(filter %/04_03_intt_n4096.c %/07_02_intt_n4096.c,$(CASE_SOURCE)),)
SRCS += $(HPU_GENERATED_ROOT)/transform-data/intt/intt.c
endif
ifneq ($(filter %/04_01_bconv_q4_to_p3_n4096.c,$(CASE_SOURCE)),)
SRCS += $(TEST_ROOT)/src/common/it_bconv.c
SRCS += $(TEST_ROOT)/src/common/it_bconv_fixture.S
SRCS += $(HPU_GENERATED_ROOT)/bconv-data/bconv.c
INC_DIR += $(HPU_GENERATED_ROOT)/bconv-data
endif
ifneq ($(filter %/04_10_legacy_auto_n4096.c,$(CASE_SOURCE)),)
ifeq ($(wildcard $(HPU_GENERATED_ROOT)/auto-data/auto_delivery.h),)
$(error missing Auto delivery; run 'make prepare-inline-asm-mm')
endif
SRCS += $(TEST_ROOT)/src/common/it_auto.c
SRCS += $(TEST_ROOT)/src/common/it_auto_fixture.S
SRCS += $(HPU_GENERATED_ROOT)/auto-data/auto.c
INC_DIR += $(HPU_GENERATED_ROOT)/auto-data
endif
# 所有 scheme 用例沿用原目录；从显式清单选取本例的独立 producer 程序。
ifneq ($(strip $(APPLICATION_STEM)),)
APPLICATION_DATA := $(HPU_GENERATED_ROOT)/$(APPLICATION_DELIVERY)/$(APPLICATION_STEM)
ifeq ($(wildcard $(APPLICATION_DATA)/application_layout.h),)
$(error missing $(CASE_ID) application delivery; run 'make prepare-inline-asm-mm')
endif
SRCS += $(TEST_ROOT)/src/common/it_application.c
SRCS += $(TEST_ROOT)/src/common/it_application_fixture.S
ifneq ($(strip $(PERF_STEM)),)
ifeq ($(wildcard $(APPLICATION_DATA)/$(APPLICATION_STEM)_perf.h),)
$(error missing preflight/issue adapter; run scripts/prepare-perf-programs.py --generated $(HPU_GENERATED_ROOT))
endif
SRCS += $(APPLICATION_DATA)/$(APPLICATION_STEM)_perf.c
else
SRCS += $(APPLICATION_DATA)/$(APPLICATION_STEM).c
endif
INC_DIR += $(APPLICATION_DATA)
ASFLAGS += -Wa,-I$(APPLICATION_DATA)
$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_application_fixture.o: \
  $(addprefix $(APPLICATION_DATA)/,application_window.u32.bin \
  application_golden.u32.bin application_writable.u8.bin)
endif
endif
ifeq ($(HPU_LOG_LEVEL),0)
# 不改共享 AM/klib。封住初始化和字符出口，启动路径也不能等待 UART。
SRCS += $(TEST_ROOT)/runtime/it_log_silent.c
HPU_SILENT_WRAPS := printf_ printf atomic_printf_ vprintf_ vprintf puts putchar _putc _putchar \
  __am_uartlite_putchar __am_16550_putchar __am_init_uartlite __am_init_16550
LDFLAGS += $(addprefix --wrap=,$(HPU_SILENT_WRAPS))
endif
DST_DIR := $(HPU_DST_DIR)
INC_DIR += $(HPU_GENERATED_ROOT)/include $(TEST_ROOT)/include
CFLAGS += -Wall -Wextra -Werror -ffunction-sections -fdata-sections \
          -DLINKNAN_HPU_IT=1 \
          -DHPU_DUMP_RESULTS=$(HPU_DUMP_RESULTS) \
          -DHPU_LOG_LEVEL=$(HPU_LOG_LEVEL) \
          -DHPU_APPLICATION_TIMEOUT_CYCLES=$(HPU_APPLICATION_TIMEOUT_CYCLES) -include hpu/log.h \
          -DHPU_PERF_WARMUP_ROUNDS=$(HPU_PERF_WARMUP_ROUNDS) \
          -DHPU_PERF_MEASURE_ROUNDS=$(HPU_PERF_MEASURE_ROUNDS) \
          -ffile-prefix-map=$(TEST_ROOT)=tests/hputest \
          -fmacro-prefix-map=$(TEST_ROOT)=tests/hputest \
          -ffile-prefix-map=$(INLINE_ASM_ROOT)=inline-asm \
          -fmacro-prefix-map=$(INLINE_ASM_ROOT)=inline-asm \
          -ffile-prefix-map=$(AM_HOME)=nexus-am \
          -fmacro-prefix-map=$(AM_HOME)=nexus-am

include $(AM_HOME)/Makefile.app

# 即使手工复用 HPU_DST_DIR，切换 UART 模式也必须重编译所有用例对象。
HPU_UART_FLAGS := $(HPU_DST_DIR)/.uart-mode
.PHONY: hpu-uart-flags-force
$(HPU_UART_FLAGS): hpu-uart-flags-force
	@mkdir -p "$(dir $@)"
	@printf 'HPU_DUMP_RESULTS=%s\nHPU_LOG_LEVEL=%s\nAPP_WAIT_CYCLES=%s\n' '$(HPU_DUMP_RESULTS)' '$(HPU_LOG_LEVEL)' '$(HPU_APPLICATION_TIMEOUT_CYCLES)' > "$@.new"
	@if cmp -s "$@.new" "$@"; then rm -f "$@.new"; else mv -f "$@.new" "$@"; fi
$(OBJS): $(HPU_UART_FLAGS)

# .incbin 的二进制依赖不会出现在预处理器生成的 .d 中。
$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/hpu_rns_fixture.o: \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/images/input_a.u32.bin \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/images/input_b.u32.bin
$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/hpu_mm_fixture.o: \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/images/expected.u32.bin \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/constants/mod_ctx.u32.bin

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_stage_twiddle.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/instruction-data/,ntt_stage_00.u32.bin \
  ntt_stage_01.u32.bin ntt_stage_11.u32.bin intt_stage_00.u32.bin \
  intt_stage_01.u32.bin intt_stage_11.u32.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_transform_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/transform-data/,ntt/window.u32.bin \
  ntt/golden.u32.bin intt/window.u32.bin intt/golden.u32.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_bconv_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/bconv-data/,window.u32.bin \
  golden_p.u32.bin normalized_cpu.u32.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_keyswitch_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/keyswitch-data/,window.u32.bin \
  golden.u32.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_auto_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/auto-data/,window.u32.bin \
  golden.u32.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_hadd_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/hadd-data/,window.u32.bin \
  golden.u32.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_hmul_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/hmul-data/,window.u32.bin \
  golden.u32.bin writable_lines.u8.bin)

$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/it_rotate_fixture.o: \
  $(addprefix $(HPU_GENERATED_ROOT)/rotate-data/,window.u32.bin \
  golden.u32.bin rotate_writable.u8.bin)

# Nexus-AM adds -ggdb in Makefile.compile.  Published smoke ELFs do not need
# checkout-specific debug paths.
CFLAGS += -g0
