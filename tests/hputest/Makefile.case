ifndef AM_HOME
$(error AM_HOME must point to this Nexus-AM checkout)
endif
ifndef CASE_SOURCE
$(error CASE_SOURCE must name one directed HPU testcase source)
endif
ifndef CASE_ID
$(error CASE_ID must name one directed HPU testcase)
endif
ifndef HPU_DST_DIR
$(error HPU_DST_DIR must name the testcase object directory)
endif
ifndef CASE_BINARY
$(error CASE_BINARY must name the testcase ELF/BIN basename)
endif
ifeq ($(origin BINARY),command line)
$(error use CASE_BINARY, not BINARY; recursive AM builds must keep their own paths)
endif
ifeq ($(origin DST_DIR),command line)
$(error use HPU_DST_DIR, not DST_DIR; recursive AM builds must keep their own paths)
endif

TEST_ROOT := $(CURDIR)
INLINE_ASM_ROOT ?= $(TEST_ROOT)/third_party/inline-asm
HPU_GENERATED_ROOT ?= $(TEST_ROOT)/build/generated
HPU_DUMP_RESULTS ?= 0
HPU_LOG_LEVEL ?= 1
HPU_APPLICATION_TIMEOUT_CYCLES ?= 25000000
HPU_PERF_WARMUP_ROUNDS ?= 1
HPU_PERF_MEASURE_ROUNDS ?= 3
ifeq ($(filter $(HPU_LOG_LEVEL),0 1 2),)
$(error HPU_LOG_LEVEL must be 0, 1, or 2)
endif
ifeq ($(filter $(HPU_DUMP_RESULTS),0 1),)
$(error HPU_DUMP_RESULTS must be 0 or 1)
endif
ifeq ($(HPU_DUMP_RESULTS),1)
ifneq ($(HPU_LOG_LEVEL),2)
$(error HPU_DUMP_RESULTS=1 requires HPU_LOG_LEVEL=2)
endif
endif

# 此入口只编译原有00～02共35项定向测试；03～07走Makefile.native.case。
LOWLEVEL_GROUP := $(firstword $(subst _, ,$(CASE_ID)))
ifeq ($(LOWLEVEL_GROUP),00)
EXPECTED_SOURCE := $(TEST_ROOT)/src/00_smoke/$(CASE_ID).c
else ifeq ($(LOWLEVEL_GROUP),01)
EXPECTED_SOURCE := $(TEST_ROOT)/src/01_connection/$(CASE_ID).c
else ifeq ($(LOWLEVEL_GROUP),02)
EXPECTED_SOURCE := $(TEST_ROOT)/src/02_boundary/$(CASE_ID).c
else
$(error CASE_ID is not a supported directed 00/01/02 testcase)
endif
ifneq ($(abspath $(CASE_SOURCE)),$(EXPECTED_SOURCE))
$(error CASE_SOURCE must match the canonical directed source for CASE_ID)
endif
ifeq ($(wildcard $(EXPECTED_SOURCE)),)
$(error directed source does not exist: $(EXPECTED_SOURCE))
endif

INLINE_ASM_MM_ROOT := $(HPU_GENERATED_ROOT)/inline-asm/mm
ASFLAGS += -Wa,-I$(INLINE_ASM_MM_ROOT)/test_data/hardware
ASFLAGS += -Wa,-I$(HPU_GENERATED_ROOT)/instruction-data
ifeq ($(wildcard $(HPU_GENERATED_ROOT)/include/hpu/inline_asm_mm_delivery.h),)
$(error missing generated current-ISA delivery; run scripts/prepare-lowlevel.py)
endif

NAME := $(CASE_ID)
SRCS := $(CASE_SOURCE)
ifeq ($(LOWLEVEL_GROUP),00)
ifneq ($(filter 00_01_% 00_02_% 00_03_% 00_04_% 00_05_% 00_06_% \
                00_07_% 00_08_% 00_09_%,$(CASE_ID)),)
SRCS += $(TEST_ROOT)/src/common/hpu_rns_fixture.S
endif
ifneq ($(filter 00_04_psync_irq 00_05_dload_irq 00_07_loopback_irq \
                00_08_compute_irq,$(CASE_ID)),)
SRCS += $(TEST_ROOT)/src/common/hpu_irq.c
endif
ifneq ($(filter 00_08_compute_irq 00_09_compute_mmio,$(CASE_ID)),)
ifeq ($(wildcard $(INLINE_ASM_MM_ROOT)/mm.c),)
$(error missing complete current producer MM program)
endif
SRCS += $(TEST_ROOT)/src/common/hpu_mm_fixture.S $(INLINE_ASM_MM_ROOT)/mm.c
INC_DIR += $(INLINE_ASM_MM_ROOT)
endif
else
# 只取it_*.c，不把native_case.c混进每个定向ELF；静默出口按选项单独加入。
HPU_IT_RUNTIME_SRCS := $(filter-out $(TEST_ROOT)/runtime/it_log_silent.c,\
    $(sort $(wildcard $(TEST_ROOT)/runtime/it_*.c)))
ifeq ($(strip $(HPU_IT_RUNTIME_SRCS)),)
$(error missing directed IT runtime sources)
endif
SRCS += $(HPU_IT_RUNTIME_SRCS) $(TEST_ROOT)/src/common/hpu_rns_fixture.S
endif

ifeq ($(HPU_LOG_LEVEL),0)
SRCS += $(TEST_ROOT)/runtime/it_log_silent.c
HPU_SILENT_WRAPS := printf_ printf atomic_printf_ vprintf_ vprintf puts putchar _putc _putchar \
  __am_uartlite_putchar __am_16550_putchar __am_init_uartlite __am_init_16550
LDFLAGS += $(addprefix --wrap=,$(HPU_SILENT_WRAPS))
endif

# 构建路径只在本层赋值，不随MAKEFLAGS覆盖递归AM/klib的BINARY/DST_DIR。
DST_DIR := $(HPU_DST_DIR)
BINARY := $(CASE_BINARY)
unexport DST_DIR BINARY
INC_DIR += $(HPU_GENERATED_ROOT)/include $(TEST_ROOT)/include
CFLAGS += -Wall -Wextra -Werror -ffunction-sections -fdata-sections \
          -DLINKNAN_HPU_IT=1 -DHPU_DUMP_RESULTS=$(HPU_DUMP_RESULTS) \
          -DHPU_LOG_LEVEL=$(HPU_LOG_LEVEL) -include hpu/log.h \
          -DHPU_APPLICATION_TIMEOUT_CYCLES=$(HPU_APPLICATION_TIMEOUT_CYCLES) \
          -DHPU_PERF_WARMUP_ROUNDS=$(HPU_PERF_WARMUP_ROUNDS) \
          -DHPU_PERF_MEASURE_ROUNDS=$(HPU_PERF_MEASURE_ROUNDS) \
          -ffile-prefix-map=$(TEST_ROOT)=tests/hputest \
          -fmacro-prefix-map=$(TEST_ROOT)=tests/hputest \
          -ffile-prefix-map=$(INLINE_ASM_ROOT)=inline-asm \
          -fmacro-prefix-map=$(INLINE_ASM_ROOT)=inline-asm \
          -ffile-prefix-map=$(AM_HOME)=nexus-am \
          -fmacro-prefix-map=$(AM_HOME)=nexus-am

include $(AM_HOME)/Makefile.app
CFLAGS += -g0

# 日志模式切换会重新编译本例对象，不修改公共AM库。
HPU_UART_FLAGS := $(HPU_DST_DIR)/.uart-mode
.PHONY: hpu-uart-flags-force
$(HPU_UART_FLAGS): hpu-uart-flags-force
	@mkdir -p "$(dir $@)"
	@printf 'HPU_DUMP_RESULTS=%s\nHPU_LOG_LEVEL=%s\nAPP_WAIT_CYCLES=%s\n' '$(HPU_DUMP_RESULTS)' '$(HPU_LOG_LEVEL)' '$(HPU_APPLICATION_TIMEOUT_CYCLES)' > "$@.new"
	@if cmp -s "$@.new" "$@"; then rm -f "$@.new"; else mv -f "$@.new" "$@"; fi
$(OBJS): $(HPU_UART_FLAGS)

# 汇编.incbin依赖不在预处理器.d里，显式列出种子与完整C参考表。
$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/hpu_rns_fixture.o: \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/images/input_a.u32.bin \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/images/input_b.u32.bin
$(HPU_DST_DIR)/$(TEST_ROOT)/src/common/hpu_mm_fixture.o: \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/images/expected.u32.bin \
  $(INLINE_ASM_MM_ROOT)/test_data/hardware/constants/mod_ctx.u32.bin
